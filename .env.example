# Core
ENVIRONMENT=development
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+asyncpg://tintinhr:tintinhr@postgres:5432/tintinhr
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000

# AI providers: ollama | openai | groq | gemini
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_API_KEY=
LLM_BASE_URL=http://host.docker.internal:11434/v1

# Embeddings: sentence_transformers | openai
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true

# Retrieval and guardrails
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
FINAL_TOP_K=6
MIN_RETRIEVAL_SCORE=0.20
MAX_UPLOAD_MB=20

# Optional tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=TintinHR

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

